{
  "name": "playwright-bdd-framework",
  "version": "1.0.0",
  "private": true,
  "description": "A Cucumber BDD framework using Playwright and TypeScript",
  "scripts": {
    "test:bdd": "tsx test-runner/runner.ts",
    "test:bdd:html": "tsx test-runner/runner.ts",
    "test:bdd:headed": "tsx test-runner/runner.ts --headed",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.0.0",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.5",
    "playwright": "^1.49.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
